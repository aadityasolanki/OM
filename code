SELECT c.person_name AS name,
       CASE WHEN c.all_day = 'Y' THEN 'Full day'
            WHEN c.end_time IS NOT NULL THEN c.start_time || ' - ' || c.end_time
            WHEN TRUNC(SYSDATE) = c.start_date THEN 'From ' || c.start_time
            ELSE 'Full day' END AS hours,
       c.end_date AS back_after,
       c.status
FROM   mlr_calendar_v c
WHERE  UPPER(c.site) = UPPER(:P44_SITE)
