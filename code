SELECT c.id,
       c.person_name ||
       CASE WHEN c.all_day = 'Y' THEN NULL
            WHEN c.start_time IS NULL THEN
                 ' (until ' || TO_CHAR(TO_DATE(c.end_time, 'HH24:MI'), 'FMHH:MI AM') || ')'
            WHEN c.end_time IS NOT NULL THEN
                 ' (' || TO_CHAR(TO_DATE(c.start_time, 'HH24:MI'), 'FMHH:MI AM') || ' - '
                      || TO_CHAR(TO_DATE(c.end_time,   'HH24:MI'), 'FMHH:MI AM') || ')'
            WHEN c.start_date = c.end_date THEN
                 ' (from ' || TO_CHAR(TO_DATE(c.start_time, 'HH24:MI'), 'FMHH:MI AM') || ')'
            ELSE ' (from ' || TO_CHAR(TO_DATE(c.start_time, 'HH24:MI'), 'FMHH:MI AM')
                           || ' on ' || TO_CHAR(c.start_date, 'DD-MON') || ')'
       END ||
       CASE WHEN c.status = 'PENDING' THEN ' - pending' END AS title,
       c.cal_start,
       CASE WHEN c.all_day = 'Y' THEN c.cal_end + 1 ELSE c.cal_end END AS cal_end,
       CASE c.status WHEN 'APPROVED' THEN 'apex-cal-green' ELSE 'apex-cal-silver mlr-pending' END AS css_class,
       c.person_name || ' - ' ||
       CASE WHEN c.all_day = 'Y' THEN 'Full day'
            WHEN c.start_time IS NULL THEN 'Until ' || TO_CHAR(TO_DATE(c.end_time, 'HH24:MI'), 'FMHH:MI AM')
            WHEN c.end_time IS NOT NULL THEN TO_CHAR(TO_DATE(c.start_time, 'HH24:MI'), 'FMHH:MI AM') || ' to '
                                          || TO_CHAR(TO_DATE(c.end_time,   'HH24:MI'), 'FMHH:MI AM')
            ELSE 'From ' || TO_CHAR(TO_DATE(c.start_time, 'HH24:MI'), 'FMHH:MI AM') || ' on ' || TO_CHAR(c.start_date, 'DD-MON')
       END ||
       CASE WHEN c.status = 'PENDING' THEN ' (waiting for approval)' END AS info
FROM   mlr_calendar_v c
WHERE  UPPER(c.site) = UPPER(:P44_SITE)
AND    mlr_api.can_see_site(:APP_USER, c.site) = 'Y'
