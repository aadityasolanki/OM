var b   = this.triggeringElement;
var id  = b.dataset.id;
var act = b.dataset.act;
var note;

if (act === 'REJECT') {
  note = window.prompt('Reject leave request ' + id + '. Reason (required):', '');
  if (note === null) { return; }
  if (!note.trim()) { apex.message.alert('A reason is required to reject.'); return; }
} else {
  note = window.prompt('Approve leave request ' + id + '? Comment (optional):', '');
  if (note === null) { return; }
}
apex.page.submit({ request: act, set: { 'P43_ID': id, 'P43_COMMENT': note }, showWait: true });


