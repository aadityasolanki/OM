Step 5: Replace the "Ticket Action" process

START,HOLD,RESUME,ADD_COMMENT,LINE_PASS,LINE_PASS_FL,LINE_FAIL,ALL_PASS,ALL_PASS_FL


DECLARE
  PROCEDURE pass_all (p_to VARCHAR2) IS
  BEGIN
    FOR l IN (SELECT id FROM insp_ticket_lines
              WHERE  ticket_id = :P34_TICKET_ID AND line_status = 'OPEN'
              ORDER  BY line_no)
    LOOP
      insp_api.result_line(l.id, 'PASS', :APP_USER, NULL, p_to);
    END LOOP;
    insp_api.add_comment(:P34_TICKET_ID, NULL, NULL, :P34_NEW_COMMENT, :APP_USER);
  END;
BEGIN
  CASE :REQUEST
    WHEN 'START'  THEN insp_api.start_inspection(:P34_TICKET_ID, :APP_USER);
    WHEN 'HOLD'   THEN
      IF TRIM(:P34_NEW_COMMENT) IS NULL THEN
        RAISE_APPLICATION_ERROR(-20100, 'Type the hold reason in the comment box first.');
      END IF;
      insp_api.hold_inspection(:P34_TICKET_ID, :APP_USER, :P34_NEW_COMMENT);
    WHEN 'RESUME' THEN insp_api.resume_inspection(:P34_TICKET_ID, :APP_USER);
    WHEN 'ADD_COMMENT' THEN
      insp_api.add_comment(:P34_TICKET_ID, NULL, NULL, :P34_NEW_COMMENT, :APP_USER);
    WHEN 'LINE_PASS' THEN
      insp_api.result_line(:P34_LINE_ID, 'PASS', :APP_USER, :P34_NEW_COMMENT);
    WHEN 'LINE_PASS_FL' THEN
      IF :P34_TO_LOCATION IS NULL THEN
        RAISE_APPLICATION_ERROR(-20100, 'Pick the Forklift To location first.');
      END IF;
      insp_api.result_line(:P34_LINE_ID, 'PASS', :APP_USER, :P34_NEW_COMMENT, :P34_TO_LOCATION);
    WHEN 'LINE_FAIL' THEN
      IF TRIM(:P34_NEW_COMMENT) IS NULL THEN
        RAISE_APPLICATION_ERROR(-20100, 'Type what needs rework in the comment box first.');
      END IF;
      insp_api.result_line(:P34_LINE_ID, 'FAIL', :APP_USER, 'Rework needed: ' || :P34_NEW_COMMENT);
    WHEN 'ALL_PASS' THEN
      pass_all(NULL);
    WHEN 'ALL_PASS_FL' THEN
      IF :P34_TO_LOCATION IS NULL THEN
        RAISE_APPLICATION_ERROR(-20100, 'Pick the Forklift To location first.');
      END IF;
      pass_all(:P34_TO_LOCATION);
    ELSE
      RAISE_APPLICATION_ERROR(-20100, 'Unknown button: ' || :REQUEST);
  END CASE;
  :P34_NEW_COMMENT := NULL;
END;

















