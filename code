Pre-Rendering → Before Header → Process "Who Am I":

:P35_IS_DRIVER := insp_api.is_driver(:APP_USER);
:P35_IS_MGR    := insp_api.is_manager(:APP_USER);


	•	Server-side Condition, PL/SQL Expression: :P35_IS_DRIVER = 'Y' OR :P35_IS_MGR = 'Y'

SELECT f.id                 AS move_no,
       f.job,
       f.op_seq,
       f.from_location_name AS pick_up,
       f.to_location_name   AS drop_off,
       f.source,
       f.requested_by,
       f.requested_ts       AS requested,
       ROUND((CAST(SYSTIMESTAMP AS DATE) - CAST(f.requested_ts AS DATE)) * 1440) AS minutes_waiting,
       CASE WHEN :P35_IS_DRIVER = 'Y' THEN
         '<button type="button" class="t-Button t-Button--small t-Button--hot fl-act" data-id="' || f.id || '" data-act="CLAIM">Claim</button>'
       END AS actions
FROM   fl_tickets f
WHERE  f.status = 'OPEN'
ORDER  BY f.requested_ts


Condition: :P35_IS_DRIVER = 'Y'

SELECT f.id                 AS move_no,
       f.job,
       f.op_seq,
       f.from_location_name AS pick_up,
       f.to_location_name   AS drop_off,
       f.status,
       f.claimed_ts         AS claimed,
       f.picked_up_ts       AS picked_up,
       CASE f.status
         WHEN 'CLAIMED'   THEN '<button type="button" class="t-Button t-Button--small t-Button--primary fl-act" data-id="' || f.id || '" data-act="PICKUP">Picked Up</button>'
         WHEN 'PICKED_UP' THEN '<button type="button" class="t-Button t-Button--small t-Button--success fl-act" data-id="' || f.id || '" data-act="DELIVER">Delivered</button>'
       END AS actions
FROM   fl_tickets f
WHERE  UPPER(f.driver) = UPPER(:APP_USER)
AND    f.status IN ('CLAIMED', 'PICKED_UP')
ORDER  BY f.claimed_ts


	•	No condition: everyone sees their own calls.


SELECT f.id                 AS move_no,
       f.job,
       f.from_location_name AS pick_up,
       f.to_location_name   AS drop_off,
       f.status,
       f.driver,
       f.requested_ts       AS requested,
       f.delivered_ts       AS delivered,
       CASE WHEN f.status = 'OPEN' THEN
         '<button type="button" class="t-Button t-Button--small t-Button--danger fl-act" data-id="' || f.id || '" data-act="CANCEL">Cancel</button>'
       END AS actions
FROM   fl_tickets f
WHERE  UPPER(f.requested_by) = UPPER(:APP_USER)
AND    (f.status IN ('OPEN', 'CLAIMED', 'PICKED_UP') OR f.requested_ts > SYSTIMESTAMP - INTERVAL '1' DAY)
ORDER  BY f.requested_ts DESC


	•	Condition: :P35_IS_MGR = 'Y'


SELECT f.id                 AS move_no,
       f.job,
       f.from_location_name AS pick_up,
       f.to_location_name   AS drop_off,
       f.status,
       f.driver,
       f.requested_by,
       f.requested_ts       AS requested,
       f.claimed_ts         AS claimed,
       f.picked_up_ts       AS picked_up,
       ROUND((CAST(SYSTIMESTAMP AS DATE) - CAST(f.requested_ts AS DATE)) * 1440) AS minutes_open,
       CASE WHEN f.status IN ('CLAIMED', 'PICKED_UP') THEN
         '<button type="button" class="t-Button t-Button--small t-Button--warning fl-act" data-id="' || f.id || '" data-act="RELEASE">Release</button> '
       END ||
       '<button type="button" class="t-Button t-Button--small t-Button--danger fl-act" data-id="' || f.id || '" data-act="CANCEL">Cancel</button>' AS actions
FROM   fl_tickets f
WHERE  f.status IN ('OPEN', 'CLAIMED', 'PICKED_UP')
ORDER  BY f.requested_ts


DA "Forklift Action":

	•	Event Click, jQuery Selector .fl-act, Event Scope: Dynamic
	•	True action Execute JavaScript Code:


var b   = this.triggeringElement;
var act = b.dataset.act;
var set = { 'P35_FL_ID': b.dataset.id };

if (act === 'CANCEL' || act === 'RELEASE') {
  var reason = window.prompt('Reason for ' + (act === 'CANCEL' ? 'cancelling' : 'releasing') +
                             ' move ' + b.dataset.id + ':');
  if (!reason || !reason.trim()) { return; }
  set['P35_REASON'] = reason.trim();
}
apex.page.submit({ request: act, set: set, showWait: true });


