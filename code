SELECT MIN(a.site) INTO :P44_SITE
FROM   app_user_roles a
WHERE  a.is_active = 'Y'
AND    UPPER(a.site) NOT IN ('ALL', 'ALL SITES')
AND    UPPER(a.site) IN (SELECT UPPER(x.site) FROM app_user_roles x
                         WHERE  UPPER(x.unixid) = UPPER(:APP_USER) AND x.is_active = 'Y')
AND    mlr_api.can_see_site(:APP_USER, a.site) = 'Y';

IF :P44_SITE IS NULL THEN          -- ALL-sites users with no own site: first site in the list
  SELECT MIN(a.site) INTO :P44_SITE
  FROM   app_user_roles a
  WHERE  a.is_active = 'Y' AND UPPER(a.site) NOT IN ('ALL', 'ALL SITES');
END IF;


	•	Name: Who Is Off · Type: Calendar · Static ID: mlr_cal

SELECT c.id,
       c.person_name || CASE WHEN c.status = 'PENDING' THEN ' (pending)' END AS title,
       c.cal_start,
       c.cal_end,
       CASE c.status WHEN 'APPROVED' THEN 'apex-cal-green' ELSE 'apex-cal-silver mlr-pending' END AS css_class,
       c.person_name || ' - ' ||
       CASE WHEN c.all_day = 'Y' THEN 'Full day'
            WHEN c.end_time IS NOT NULL THEN c.start_time || ' to ' || c.end_time
            ELSE 'From ' || c.start_time || ' on ' || TO_CHAR(c.start_date, 'DD-MON') END ||
       CASE WHEN c.status = 'PENDING' THEN ' (waiting for approval)' END AS info
FROM   mlr_calendar_v c
WHERE  UPPER(c.site) = UPPER(:P44_SITE)
AND    mlr_api.can_see_site(:APP_USER, c.site) = 'Y'

