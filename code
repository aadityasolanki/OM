DECLARE
  c_card CONSTANT VARCHAR2(400) :=
    'cursor:pointer; width:180px; background:#ffffff; border-radius:10px; ' ||
    'box-shadow:0 2px 8px rgba(0,0,0,0.1); padding:24px 16px; text-align:center; border-top:4px solid ';
  c_color CONSTANT VARCHAR2(10) := '#14b8a6';
  v      CLOB;
  n      NUMBER;
  v_sup  NUMBER;

  FUNCTION card (p_page NUMBER, p_icon VARCHAR2, p_title VARCHAR2, p_sub VARCHAR2) RETURN VARCHAR2 IS
  BEGIN
    RETURN '<div onclick="apex.navigation.redirect(''' || apex_page.get_url(p_page => p_page) || ''')"'
        || ' style="' || c_card || c_color || ';">'
        || '<div style="font-size:36px;"><span class="fa ' || p_icon || '"></span></div>'
        || '<div style="margin-top:10px; font-weight:bold; font-size:13px;">' || p_title || '</div>'
        || '<div style="font-size:11px; color:#9ca3af; margin-top:4px;">' || p_sub || '</div></div>';
  END;
BEGIN
  IF mlr_api.can_request(:APP_USER) = 'N' THEN
    RETURN NULL;                         -- floor operators, inspectors, union: no Leave section
  END IF;

  v := '<div style="display:flex; flex-wrap:wrap; gap:20px; padding:0 20px 20px 20px;">'
    || '<div style="width:100%; margin-top:24px; margin-bottom:16px;">'
    || '<div style="font-size:13px; font-weight:700; color:#333; text-transform:uppercase; letter-spacing:1px;">Manager Leave</div>'
    || '<div style="height:3px; width:60px; background:' || c_color || '; margin-top:6px; border-radius:2px;"></div></div>';

  -- My Leave Requests: my pending count
  SELECT COUNT(*) INTO n FROM mlr_requests
  WHERE  requester = UPPER(:APP_USER) AND status = 'PENDING';
  v := v || card(41, 'fa-calendar-plus-o', 'My Leave Requests',
                 CASE WHEN n = 0 THEN 'Request time off' ELSE n || ' waiting for approval' END);

  -- Leave Approvals: only for people who supervise someone, or have something to decide
  SELECT COUNT(*) INTO v_sup FROM idm_personnel_v
  WHERE  UPPER(supervisor_id) = UPPER(:APP_USER) AND ROWNUM = 1;

  SELECT COUNT(*) INTO n FROM mlr_requests r
  WHERE  r.status = 'PENDING' AND mlr_api.can_decide(r.id, :APP_USER) = 'Y';

  IF v_sup > 0 OR n > 0 THEN
    v := v || card(43, 'fa-check-circle-o', 'Leave Approvals',
                   CASE WHEN n = 0 THEN 'Nothing waiting' ELSE n || ' to approve' END);
  END IF;

  -- Manager Calendar (Page 44): un-comment these two lines once Page 44 is built
  -- v := v || card(44, 'fa-calendar', 'Manager Calendar', 'Who is off');

  RETURN v || '</div>';
END;
