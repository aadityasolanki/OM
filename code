Step 3: Region "Waiting for My Approval" (Classic Report)

	•	Static ID: mlr_pending
	•	When No Data Found: Nothing waiting for your approval.

SELECT r.id AS request_no,
       NVL((SELECT MIN(i.last_name || ', ' || i.first_name) FROM idm_personnel_v i
            WHERE  UPPER(i.shortname) = r.requester), r.requester) AS employee,
       r.site,
       r.start_date AS first_day,
       r.end_date   AS last_day,
       r.end_date - r.start_date + 1 AS days,
       CASE WHEN r.start_time IS NULL AND r.end_time IS NULL THEN 'Full day'
            WHEN r.end_time IS NOT NULL THEN r.start_time || ' - ' || r.end_time
            ELSE 'From ' || r.start_time || ' on first day' END AS hours,
       r.comments,
       r.submitted_ts AS submitted,
       CASE WHEN UPPER(:APP_USER) = r.approver1 THEN 'My team'
            WHEN UPPER(:APP_USER) = r.approver2 THEN 'Next level'
            ELSE 'Site admin' END AS approve_as,
       '<button type="button" class="t-Button t-Button--small t-Button--success mlr-decide" data-id="' || r.id || '" data-act="APPROVE">Approve</button> ' ||
       '<button type="button" class="t-Button t-Button--small t-Button--danger mlr-decide" data-id="' || r.id || '" data-act="REJECT">Reject</button>' AS actions
FROM   mlr_requests r
WHERE  r.status = 'PENDING'
AND    mlr_api.can_decide(r.id, :APP_USER) = 'Y'
ORDER  BY r.start_date, r.submitted_ts


ACTIONS: Heading Actions, Escape special characters Off

Step 4: Region "Decided by Me" (Interactive Report)


SELECT r.id AS request_no,
       NVL((SELECT MIN(i.last_name || ', ' || i.first_name) FROM idm_personnel_v i
            WHERE  UPPER(i.shortname) = r.requester), r.requester) AS employee,
       r.site,
       r.start_date AS first_day,
       r.end_date   AS last_day,
       r.status,
       r.decided_level,
       r.decided_ts AS decided,
       r.decision_comment
FROM   mlr_requests r
WHERE  r.decided_by = UPPER(:APP_USER)
AND    r.decided_ts > SYSTIMESTAMP - INTERVAL '90' DAY
ORDER  BY r.decided_ts DESC


