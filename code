CONNECT BY LEVEL <= 48


	•	Client-side Condition: JavaScript Expression

!$v('P42_END_DATE') || $v('P42_END_DATE') === $v('P42_START_DATE')


•	Server-side Condition: PL/SQL Expression :REQUEST IS NULL OR :REQUEST <> 'SAVE'

DECLARE
  r       mlr_requests%ROWTYPE;
  v_site  VARCHAR2(100);
  v_count NUMBER;
BEGIN
  IF :P42_ID IS NOT NULL THEN
    SELECT * INTO r FROM mlr_requests WHERE id = :P42_ID;
    IF UPPER(r.requester) <> UPPER(:APP_USER) THEN
      RAISE_APPLICATION_ERROR(-20200, 'You can only change your own leave requests.');
    END IF;
    IF r.status NOT IN ('PENDING', 'APPROVED') THEN
      RAISE_APPLICATION_ERROR(-20200, 'Request ' || r.id || ' is ' || r.status || ' and can no longer be changed.');
    END IF;
    :P42_SITE       := r.site;
    :P42_START_DATE := TO_CHAR(r.start_date, 'DD-MON-YYYY');
    :P42_END_DATE   := CASE WHEN r.end_date > r.start_date THEN TO_CHAR(r.end_date, 'DD-MON-YYYY') END;
    :P42_START_TIME := r.start_time;
    :P42_END_TIME   := r.end_time;
    :P42_COMMENT    := r.comments;
  ELSIF :P42_SITE IS NULL THEN
    SELECT MIN(a.site), COUNT(DISTINCT UPPER(a.site)) INTO v_site, v_count
    FROM   app_user_roles a
    WHERE  a.is_active = 'Y'
    AND    UPPER(a.site) NOT IN ('ALL', 'ALL SITES')
    AND    mlr_api.can_see_site(:APP_USER, a.site) = 'Y';
    IF v_count = 1 THEN :P42_SITE := v_site; END IF;   -- one site: pick it automatically
  END IF;
EXCEPTION
  WHEN NO_DATA_FOUND THEN
    RAISE_APPLICATION_ERROR(-20200, 'Leave request ' || :P42_ID || ' was not found.');
END;



Process "Save Request" (seq 10, When Button Pressed SAVE):



DECLARE
  v_id NUMBER;
BEGIN
  IF :P42_ID IS NULL THEN
    v_id := mlr_api.submit_request(:APP_USER, :P42_SITE,
                                   TO_DATE(:P42_START_DATE, 'DD-MON-YYYY'),
                                   TO_DATE(:P42_END_DATE,   'DD-MON-YYYY'),
                                   :P42_START_TIME, :P42_END_TIME, :P42_COMMENT);
    apex_application.g_print_success_message := 'Leave request ' || v_id || ' sent to your supervisor.';
  ELSE
    mlr_api.change_request(:P42_ID, :APP_USER,
                           TO_DATE(:P42_START_DATE, 'DD-MON-YYYY'),
                           TO_DATE(:P42_END_DATE,   'DD-MON-YYYY'),
                           :P42_START_TIME, :P42_END_TIME, :P42_COMMENT);
    apex_application.g_print_success_message := 'Leave request ' || :P42_ID || ' changed and sent for approval again.';
  END IF;
END;



Region "My Requests" (Interactive Report)


SELECT r.id                     AS request_no,
       r.site,
       r.start_date             AS first_day,
       r.end_date               AS last_day,
       r.end_date - r.start_date + 1 AS days,
       CASE WHEN r.start_time IS NULL AND r.end_time IS NULL THEN 'Full day'
            WHEN r.end_time IS NOT NULL THEN r.start_time || ' - ' || r.end_time
            ELSE 'From ' || r.start_time || ' on first day' END AS hours,
       r.comments,
       r.status,
       NVL((SELECT MIN(i.last_name || ', ' || i.first_name) FROM idm_personnel_v i
            WHERE  UPPER(i.shortname) = r.approver1), r.approver1) AS supervisor,
       r.decided_by,
       r.decided_ts             AS decided,
       r.decision_comment,
       r.id                     AS change_link,
       CASE WHEN r.status IN ('PENDING', 'APPROVED') THEN
         '<button type="button" class="t-Button t-Button--small t-Button--danger mlr-cancel" data-id="' || r.id || '">Cancel</button>'
       END                      AS cancel_btn
FROM   mlr_requests r
WHERE  UPPER(r.requester) = UPPER(:APP_USER)
ORDER  BY r.start_date DESC


