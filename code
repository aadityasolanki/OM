Process "Ticket Action" (seq 10)

	•	Server-side Condition: Request is contained in Value, START,HOLD,RESUME,ADD_COMMENT

BEGIN
  CASE :REQUEST
    WHEN 'START'  THEN insp_api.start_inspection(:P34_TICKET_ID, :APP_USER);
    WHEN 'HOLD'   THEN
      IF TRIM(:P34_NEW_COMMENT) IS NULL THEN
        RAISE_APPLICATION_ERROR(-20100, 'Type the hold reason in the comment box first.');
      END IF;
      insp_api.hold_inspection(:P34_TICKET_ID, :APP_USER, :P34_NEW_COMMENT);
    WHEN 'RESUME' THEN insp_api.resume_inspection(:P34_TICKET_ID, :APP_USER);
    WHEN 'ADD_COMMENT' THEN
      insp_api.add_comment(:P34_TICKET_ID, NULL, NULL, :P34_NEW_COMMENT, :APP_USER);
  END CASE;
  :P34_NEW_COMMENT := NULL;
END;

Region "My Open Inspections" (Interactive Report):

SELECT t.id AS ticket_no,
       t.priority,
       t.status,
       (SELECT COUNT(*) FROM insp_ticket_lines l WHERE l.ticket_id = t.id) AS jobs,
       (SELECT COUNT(*) FROM insp_ticket_lines l WHERE l.ticket_id = t.id AND l.line_status = 'OPEN') AS jobs_open,
       (SELECT LISTAGG(l.job || ' / ' || l.op_seq, ', ') WITHIN GROUP (ORDER BY l.line_no)
        FROM   insp_ticket_lines l WHERE l.ticket_id = t.id) AS job_list,
       (SELECT MIN(l.from_location_name) FROM insp_ticket_lines l WHERE l.ticket_id = t.id) AS location,
       t.assigned_ts AS assigned,
       t.started_ts  AS started
FROM   insp_tickets t
WHERE  UPPER(t.assigned_inspector) = UPPER(:APP_USER)
AND    t.status IN ('ASSIGNED', 'IN_PROGRESS', 'ON_HOLD')
ORDER  BY t.priority, t.assigned_ts


