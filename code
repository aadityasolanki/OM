A2. Pre-Rendering → Before Header → Process "Load Ticket"

DECLARE
  r insp_tickets%ROWTYPE;
BEGIN
  SELECT * INTO r FROM insp_tickets WHERE id = :P34_TICKET_ID;

  IF NOT (UPPER(r.requested_by) = UPPER(:APP_USER)
          OR UPPER(NVL(r.assigned_inspector, '-')) = UPPER(:APP_USER)
          OR insp_api.is_manager(:APP_USER) = 'Y') THEN
    RAISE_APPLICATION_ERROR(-20100, 'You do not have access to ticket ' || r.id || '.');
  END IF;

  :P34_STATUS  := r.status;
  :P34_CAN_ACT := CASE WHEN UPPER(NVL(r.assigned_inspector, '-')) = UPPER(:APP_USER)
                         OR insp_api.is_manager(:APP_USER) = 'Y'
                       THEN 'Y' ELSE 'N' END;
EXCEPTION
  WHEN NO_DATA_FOUND THEN
    RAISE_APPLICATION_ERROR(-20100, 'Ticket ' || :P34_TICKET_ID || ' was not found.');
END;

