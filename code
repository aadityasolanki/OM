DELETE FROM veh_qualifications
WHERE  level_id IN (SELECT l.id
                    FROM   veh_equipment_levels l
                    JOIN   veh_equipment_categories c ON c.id = l.category_id
                    WHERE  UPPER(c.site) = 'SCRANTON'
                    AND    UPPER(c.category_name) IN ('TEST', 'APPLE'))


DELETE FROM veh_equipment_levels
WHERE  category_id IN (SELECT id FROM veh_equipment_categories
                       WHERE  UPPER(site) = 'SCRANTON'
                       AND    UPPER(category_name) IN ('TEST', 'APPLE'))



DELETE FROM veh_equipment_categories
WHERE  UPPER(site) = 'SCRANTON'
AND    UPPER(category_name) IN ('TEST', 'APPLE')
