/* ---- Forklift Board: big touch targets for rugged tablets ---- */

/* Claim / Picked Up / Delivered / Cancel / Release */
.fl-act {
  font-size: 20px !important;
  font-weight: 700 !important;
  min-width: 170px;
  min-height: 60px;
  padding: 14px 26px !important;
  border-radius: 10px !important;
  margin: 4px 0;
}
.fl-act + .fl-act { margin-left: 14px; }     /* space between Release and Cancel */

/* Bigger, easier-to-read rows */
#fl_pool td, #fl_mine td, #fl_req td, #fl_all td {
  font-size: 17px;
  padding-top: 14px !important;
  padding-bottom: 14px !important;
  vertical-align: middle;
}
#fl_pool th, #fl_mine th, #fl_req th, #fl_all th { font-size: 15px; }

/* Region titles */
#fl_pool .t-Region-title, #fl_mine .t-Region-title,
#fl_req .t-Region-title,  #fl_all .t-Region-title { font-size: 22px; }

/* Call Forklift button */
.fl-big {
  font-size: 22px !important;
  font-weight: 700 !important;
  min-height: 64px;
  padding: 16px 32px !important;
  border-radius: 10px !important;
}

