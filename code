3d. Processing

Process "Forklift Action":

	•	Condition: Request is contained in Value CLAIM,PICKUP,DELIVER,RELEASE,CANCEL


BEGIN
  CASE :REQUEST
    WHEN 'CLAIM'   THEN insp_api.claim_forklift(:P35_FL_ID, :APP_USER);
    WHEN 'PICKUP'  THEN insp_api.pickup_forklift(:P35_FL_ID, :APP_USER);
    WHEN 'DELIVER' THEN insp_api.deliver_forklift(:P35_FL_ID, :APP_USER);
    WHEN 'RELEASE' THEN insp_api.release_forklift(:P35_FL_ID, :APP_USER, :P35_REASON);
    WHEN 'CANCEL'  THEN insp_api.cancel_forklift(:P35_FL_ID, :APP_USER, :P35_REASON);
    ELSE RAISE_APPLICATION_ERROR(-20100, 'Unknown button: ' || :REQUEST);
  END CASE;
  :P35_REASON := NULL;
END;




















































