DECLARE
  v_id NUMBER;
BEGIN
  v_id := insp_api.submit_ticket(:APP_USER, :P30_COMMENT);

  INSERT INTO insp_attachments (ticket_id, file_name, mime_type, file_size, file_blob, uploaded_by)
  SELECT v_id, f.filename, f.mime_type, DBMS_LOB.GETLENGTH(f.blob_content), f.blob_content, :APP_USER
  FROM   apex_application_temp_files f
  WHERE  f.name IN (SELECT column_value FROM TABLE(apex_string.split(:P30_FILES, ':')));

  apex_application.g_print_success_message := 'Inspection ticket ' || v_id || ' submitted.';
END;


