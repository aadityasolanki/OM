SELECT (SELECT COUNT(*) FROM insp_tickets WHERE requested_ts >= TRUNC(SYSDATE)) AS submitted,
       (SELECT COUNT(*) FROM insp_tickets WHERE closed_ts    >= TRUNC(SYSDATE)) AS closed,
       (SELECT COUNT(*) FROM insp_tickets WHERE status NOT IN ('CLOSED', 'CANCELLED')) AS open_tickets,
       (SELECT COUNT(*) FROM insp_ticket_lines
        WHERE  result_ts >= TRUNC(SYSDATE) AND line_status IN ('FAILED', 'FAILED_CLOSED')) AS jobs_failed,
       (SELECT ROUND(AVG((CAST(inspected_ts AS DATE) - CAST(requested_ts AS DATE)) * 1440))
        FROM   insp_tickets WHERE inspected_ts >= TRUNC(SYSDATE)) AS avg_min_submit_to_done,
       (SELECT COUNT(*) FROM fl_tickets WHERE delivered_ts >= TRUNC(SYSDATE)) AS moves_delivered,
       (SELECT COUNT(*) FROM fl_tickets WHERE status = 'OPEN') AS moves_waiting,
       (SELECT ROUND(AVG((CAST(delivered_ts AS DATE) - CAST(requested_ts AS DATE)) * 1440))
        FROM   fl_tickets WHERE delivered_ts >= TRUNC(SYSDATE)) AS avg_min_per_move
FROM   dual


Region 2: "Open Inspections" (Classic Report)

SELECT t.id                 AS ticket_no,
       t.priority,
       t.status,
       t.assigned_inspector AS inspector,
       t.requested_by       AS submitted_by,
       (SELECT COUNT(*) FROM insp_ticket_lines l WHERE l.ticket_id = t.id) AS jobs,
       (SELECT COUNT(*) FROM insp_ticket_lines l WHERE l.ticket_id = t.id AND l.line_status = 'FAILED') AS failed_waiting,
       ROUND((CAST(SYSTIMESTAMP AS DATE) - CAST(t.requested_ts AS DATE)) * 24, 1) AS hours_open,
       ROUND((CAST(SYSTIMESTAMP AS DATE)
              - CAST(NVL((SELECT MAX(e.event_ts) FROM insp_events e
                          WHERE  e.ticket_id = t.id AND e.to_status = t.status),
                         t.requested_ts) AS DATE)) * 24, 1) AS hours_in_status
FROM   insp_tickets t
WHERE  t.status NOT IN ('CLOSED', 'CANCELLED')
ORDER  BY CASE t.status
            WHEN 'SUBMITTED'   THEN 1 WHEN 'PRIORITIZED' THEN 2 WHEN 'ASSIGNED'  THEN 3
            WHEN 'IN_PROGRESS' THEN 4 WHEN 'ON_HOLD'     THEN 5 WHEN 'INSPECTED' THEN 6 END,
          t.priority, t.requested_ts



Region 3: "Forklift Drivers" (Classic Report)

SELECT f.driver,
       COUNT(CASE WHEN f.status = 'CLAIMED'   THEN 1 END) AS claimed,
       COUNT(CASE WHEN f.status = 'PICKED_UP' THEN 1 END) AS carrying,
       LISTAGG('#' || f.id || ' ' || f.from_location_name || ' -> ' || f.to_location_name, '; ')
         WITHIN GROUP (ORDER BY f.claimed_ts) AS moves,
       ROUND(MAX((CAST(SYSTIMESTAMP AS DATE) - CAST(f.claimed_ts AS DATE)) * 1440)) AS longest_min
FROM   fl_tickets f
WHERE  f.status IN ('CLAIMED', 'PICKED_UP')
GROUP  BY f.driver
ORDER  BY f.driver



