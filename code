-- =============================================================================
-- GDLS OMS | App 260 | GD_SANDBOX
-- One-time load: Anniston employees from USERS into APP_USER_ROLES (FLOOR_OP)
-- Same method as the Lima migration (Aug-2026).
-- Run in SQL Workshop -> SQL Scripts (not SQL Commands). Upload this file unchanged.
-- Safe to re-run: people already in APP_USER_ROLES for Anniston are never changed.
-- Export App 260 before running.
-- =============================================================================

-- 0. BEFORE: how many Anniston people are in USERS, and how many are already set up
SELECT COUNT(*)                                   AS anniston_in_users,
       COUNT(emplid)                              AS with_l_number,
       COUNT(unixid)                              AS with_login,
       COUNT(CASE WHEN EXISTS (SELECT 1 FROM app_user_roles a
                               WHERE UPPER(a.unixid) = UPPER(u.unixid)
                               AND   UPPER(a.site)   = 'ANNISTON') THEN 1 END) AS already_in_app_user_roles
FROM   users u
WHERE  UPPER(u.site) = 'ANNISTON';

-- 1. Tidy the L-numbers you typed (upper case, no spaces)
UPDATE users
SET    emplid = UPPER(TRIM(emplid))
WHERE  UPPER(site) = 'ANNISTON'
AND    emplid IS NOT NULL
AND    emplid <> UPPER(TRIM(emplid));

-- 2. Fill the login (unixid) from IDM for Anniston rows that have an L-number but no login.
--    If a person has two IDM accounts (IT staff: regular + admin "_a"), the regular one is used.
UPDATE users u
SET    u.unixid = (SELECT MIN(i.shortname) KEEP (DENSE_RANK FIRST ORDER BY
                            CASE WHEN i.last_name LIKE '%\_a' ESCAPE '\' THEN 1 ELSE 0 END,
                            i.shortname)
                   FROM   idm_personnel_v i
                   WHERE  UPPER(i.hr_number) = u.emplid)
WHERE  UPPER(u.site) = 'ANNISTON'
AND    u.emplid IS NOT NULL
AND    u.unixid IS NULL;

-- 3. Add everyone who is not in APP_USER_ROLES for Anniston yet, as FLOOR_OP.
--    Roles can be changed afterwards on Page 16. One row per login (duplicates in USERS collapsed).
MERGE INTO app_user_roles t
USING (SELECT UPPER(u.unixid) AS unixid,
              MIN(u.emplid)   AS emplid
       FROM   users u
       WHERE  UPPER(u.site) = 'ANNISTON'
       AND    u.unixid IS NOT NULL
       AND    u.emplid IS NOT NULL
       GROUP  BY UPPER(u.unixid)) s
ON (UPPER(t.unixid) = s.unixid AND UPPER(t.site) = 'ANNISTON')
WHEN NOT MATCHED THEN
  INSERT (unixid, role_code, site, is_active, created_by, created_date, emplid)
  VALUES (s.unixid, 'FLOOR_OP', 'Anniston', 'Y', 'SOLANKIA', SYSDATE, s.emplid);

-- 4. Fill any missing L-number on Anniston rows that were already in APP_USER_ROLES
UPDATE app_user_roles a
SET    a.emplid = (SELECT MIN(u.emplid) FROM users u
                   WHERE  UPPER(u.unixid) = UPPER(a.unixid)
                   AND    UPPER(u.site)   = 'ANNISTON')
WHERE  UPPER(a.site) = 'ANNISTON'
AND    a.emplid IS NULL;

COMMIT;

-- 5. AFTER: Anniston users in APP_USER_ROLES by role
SELECT role_code, COUNT(*) AS users, COUNT(emplid) AS with_l_number
FROM   app_user_roles
WHERE  UPPER(site) = 'ANNISTON'
GROUP  BY role_code
ORDER  BY role_code;

-- 6. Who could NOT be added: L-number not found in IDM (typo, or person has left)
SELECT u.id, u.emplid, u.first_name, u.last_name
FROM   users u
WHERE  UPPER(u.site) = 'ANNISTON'
AND    u.emplid IS NOT NULL
AND    u.unixid IS NULL
ORDER  BY u.last_name;

-- 7. Who has no L-number at all in USERS yet
SELECT u.id, u.unixid, u.first_name, u.last_name
FROM   users u
WHERE  UPPER(u.site) = 'ANNISTON'
AND    u.emplid IS NULL
ORDER  BY u.last_name;

